# Fudepan environment variables.
#
# Local development: copy this file to .env.local and fill in the values.
# Vercel: set these in Project Settings > Environment Variables.
# Never commit real values. Only this example file belongs in the repository.

# --- Public (sent to the browser by design; row-level security protects data) ---

# Supabase project URL. Local stack: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon (publishable) key. Never put a service role or secret key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only (never prefix these with NEXT_PUBLIC_) ---

# Supabase service role key. Bypasses row-level security. Server code only.
SUPABASE_SERVICE_ROLE_KEY=
# Public base URL of this deployment, e.g. http://localhost:3000
APP_BASE_URL=
