# Fudepan environment variables.
#
# Local development: copy this file to .env.local and fill in the values.
# Vercel: set these in Project Settings > Environment Variables.
# Never commit real values. Only this example file belongs in the repository.

# --- Public (sent to the browser by design; row-level security protects data) ---

# Supabase project URL. Local stack: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon (publishable) key. Never put a service role or secret key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only (never prefix these with NEXT_PUBLIC_) ---

# Supabase service role key. Bypasses row-level security. Server code only.
SUPABASE_SERVICE_ROLE_KEY=
# Public base URL of this deployment, e.g. http://localhost:3000
APP_BASE_URL=
# --- ai& (server only) --- https://docs.aiand.com/
AIAND_BASE_URL=https://api.aiand.com/v1
# ai& API key. Server code only; never logged, never sent to the browser.
AIAND_API_KEY=
# Vision-capable model id, chosen from the account's GET /v1/models list.
AIAND_MODEL=
# Bearer secret for /api/cron/sweep (Vercel Cron sends it automatically). 16+ chars; unset = route refuses all calls.
CRON_SECRET=

# --- Demo account (server only; shown on /login, so it is public by design) ---
# Both set: /login shows "Sign in to the demo". Either unset: the demo box is hidden.
# Use an account that belongs ONLY to a fictional demo household. Local stack:
# the seeded primary caregiver, misa.demo@example.com / fudepan-demo (supabase/seed.sql).
DEMO_EMAIL=
DEMO_PASSWORD=
