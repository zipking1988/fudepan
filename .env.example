# Copy to .env.local and fill in. Never commit real values.

# Public (safe for the browser). Supabase project URL and anon (public) key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder

# Server only. NEVER prefix with NEXT_PUBLIC_ and never import in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder

# Server only. Google Cloud Vision API key for reading handwriting. Optional: without it,
# photos are stored but not read.
GOOGLE_CLOUD_VISION_API_KEY=your-vision-api-key-placeholder

# Server only. ai& (https://aiand.com) LLM provider for suggesting tasks from notes.
# Pick a vision-capable model that supports structured JSON output from GET /v1/models.
# Recommended: zai-org/glm-5.3-flash (set the real value in .env.local, never here).
AIAND_API_KEY=your_aiand_api_key
AIAND_BASE_URL=https://api.aiand.com/v1
AIAND_MODEL=choose-a-vision-capable-model

# IANA time zone used when the browser does not provide one.
DEFAULT_TIMEZONE=Asia/Tokyo
